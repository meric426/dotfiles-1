.AppleDouble
.DS_Store
.LSOverride
._*
id_rsa
.envrc
# desktop image backups
img/*.backup.jpg
# personal swap gitconfigs
homedir/.gitconfig_*
# machine-local overrides (live in ~, never tracked)
homedir/.gitconfig.local
homedir/.zshrc.local
homedir/.vim/backup/*
!homedir/.vim/backup/.gitignore
homedir/.vim/temp/*
!homedir/.vim/temp/.gitignore
homedir/.vim/.netrwhist
